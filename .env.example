APP_ENV=local
APP_NAME=chat-design-reference
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat_reference

# O harness de fundação permanece not-ready até um projeto derivado conectar
# inbox/outbox e probes reais. Não habilite apenas para silenciar healthcheck.
RUNTIME_WIRED=false

# Nunca use defaults inseguros em produção.
ADMIN_TOKEN=
WEBHOOK_SIGNING_SECRET=

# Adapter de agent runtime: stub | langgraph | crewai | custom
AGENT_RUNTIME=stub
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# MCP
MCP_ENABLED=false
MCP_CONFIG_PATH=config/mcp.servers.example.json

# Operação
QUEUE_LEASE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=15
WORKER_CONCURRENCY=2
NUDGE_AFTER_SECONDS=15
TURN_TIMEOUT_SECONDS=90
