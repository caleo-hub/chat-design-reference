{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/channel-envelope/v1",
  "title": "ChannelEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "channel",
    "channel_account_id",
    "conversation_id",
    "participant_id",
    "direction",
    "received_at",
    "correlation_id",
    "content"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider_message_id": {"type": ["string", "null"], "maxLength": 300},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "channel": {"type": "string", "minLength": 1, "maxLength": 50},
    "channel_account_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "participant_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "direction": {"enum": ["inbound", "outbound", "system"]},
    "received_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "reply_to": {"type": ["string", "null"], "maxLength": 300},
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/contentPart"}
    },
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "metadata": {
      "type": "object",
      "description": "Metadados sanitizados e namespaced; nunca headers ou secrets brutos.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "contentPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["text", "image", "audio", "video", "file", "location", "interactive"]},
        "text": {"type": ["string", "null"], "maxLength": 100000},
        "url": {"type": ["string", "null"], "format": "uri", "maxLength": 4000},
        "mime_type": {"type": ["string", "null"], "maxLength": 200},
        "name": {"type": ["string", "null"], "maxLength": 500},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": {"type": "boolean", "default": false},
        "typing": {"type": "boolean", "default": false},
        "buttons": {"type": "boolean", "default": false},
        "message_edit": {"type": "boolean", "default": false},
        "delivery_events": {"type": "boolean", "default": false},
        "read_events": {"type": "boolean", "default": false},
        "max_text_length": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
